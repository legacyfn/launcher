{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Legacy Launcher",
  "version": "4.3.6",
  "identifier": "gg.projectlegacy.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Project Legacy Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' https: data:",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "img-src": "'self' file: https: data: blob:",
        "media-src": "'self' file: https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNzEyRDI4OUI1MDhGMEIKUldRTGoxQ2JLQzF4VU1NWVZNVU53OHdXUm81V3JNdXlPb2d6cFlNRlNSMlh4VTBWQTJTS1ZLS0MK",
      "endpoints": [
        "https://github.com/legacyfn/launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}